@startuml arquitectura
!pragma layout smetana
title Diagrama de Arquitectura - Solución BanQuito Crédito + Comercializadora de Celulares (RESTful Java, GR06)
skinparam componentStyle rectangle
skinparam shadowing false
skinparam node {
  BackgroundColor #F3F6FB
  BorderColor #0B3D91
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #0B3D91
}
skinparam database {
  BackgroundColor #E8EEFB
  BorderColor #0B3D91
}

node "Clientes de la Comercializadora (MVC: vista - controlador - servicio - modelo)" as CLI {
  component "Consola\nJava 17 + Gson" as CON
  component "Escritorio\nJava Swing + FlatLaf" as ESC
  component "Móvil\nAndroid (Java)" as MOV
}

node "Servidor de aplicaciones Payara 5.2022.5 (Java EE 8)  ·  :8080" as PAY {
  component "COMERCIALIZADORA_WEB\nCliente Web JSP + Servlets" as WEB
  component "COMERCIALIZADORA (WAR)\nJAX-RS /COMERCIALIZADORA/api\n· telefonos (CRUD)\n· facturas\n· creditos (consulta)" as COM
  component "BANQUITO_CORE (WAR)\nJAX-RS /BANQUITO_CORE/api\n· creditos/sujeto/{cedula}\n· creditos/monto-maximo/{cod}\n· POST creditos\n· creditos/{cod}/amortizacion" as BAN
}

node "Docker: mysql_banquito_gr06 (MySQL 8.4)  ·  :3307" as DK {
  database "comercializadora\nCLIENTE, TELEFONO, FORMA_PAGO,\nFACTURA, DETALLE_FACTURA" as DBC
  database "banquito\nCLIENTE, CUENTA, MOVIMIENTO,\nCREDITO, AMORTIZACION" as DBB
}

actor "Navegador" as NAV
NAV --> WEB : HTTP (HTML)
CON --> COM : HTTP REST / JSON
ESC --> COM : HTTP REST / JSON
MOV --> COM : HTTP REST / JSON\n(10.0.2.2 o IP de la PC)
WEB --> COM : HTTP REST / JSON
COM --> BAN : HTTP REST / JSON\n(JAX-RS Client API)
COM --> DBC : JDBC
BAN --> DBB : JDBC
@enduml
